@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlySummonersBook" as ReadOnlySummonersBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class SummonersBook
Class ModelManager
Class UserPrefs

Class UniquePlayerList
Class Player
Class Name
Class Tag
Class Role
Class Rank
Class Champion
Class Stats
Class UniqueTeamList
Class Team
Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

SummonersBook .up.|> ReadOnlySummonersBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlySummonersBook
ModelManager -left-> "1" SummonersBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

SummonersBook *--> "1" UniquePlayerList


Player -[hidden]up--> I
UniquePlayerList -[hidden]right-> I

SummonersBook *--> "1" UniqueTeamList

UniquePlayerList --> "*" Player
UniqueTeamList -down-> "*" Team

Player *--> "*" Tag

Player *--> "1" Name
Player *--> "1" Role
Player *--> "1" Rank
Player *--> "1" Champion
Player *--> "1" Stats

Team --right> "5" Player
@enduml
